---
layout: base.njk
title: Writing — Lillian Trent
---
<div class="page-head">
  <h1>writing</h1>
  <p>short fiction, worldbuilding notes, and essays.</p>
</div>

<section>
  {%- if collections.posts.length %}
  <div class="writing-list">
  {%- for post in collections.posts | reverse %}
    <div class="write-card">
      <div class="win-bar"><span>{{ post.data.title }}.md</span><div class="dots"><i></i><i></i></div></div>
      <div class="write-body">
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p class="meta">{{ post.data.date | date("%B %d, %Y") }}</p>
        <p>{{ post.data.excerpt }}</p>
      </div>
    </div>
  {%- endfor %}
  </div>
  {%- else %}
  <p style="text-align:center; color:var(--ink-soft); font-size:15px;">nothing posted yet — check back soon.</p>
  {%- endif %}
</section>
