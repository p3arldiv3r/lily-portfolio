---
layout: base.njk
title: Lillian Trent — Portfolio
---
<div class="desktop-viewport">
  <div class="bubble-layer"></div>
  <div class="desktop-canvas">

    {%- for d in doodles.items %}
    {%- if d.display == "background" %}
    <div class="doodle-bg" style="left:{{ d.left }}px; top:{{ d.top }}px;">
      <img src="{{ d.image }}" alt="">
    </div>
    {%- endif %}
    {%- endfor %}

    {%- for d in doodles.items %}
    {%- if d.display == "sticky" %}
    <div class="doodle-sticky" style="left:{{ d.left }}px; top:{{ d.top }}px; transform:rotate({{ [-4,3,-2,5][loop.index0 % 4] }}deg);">
      <img src="{{ d.image }}" alt="a doodle from a visitor">
      {%- if d.caption %}<div class="doodle-caption">{{ d.caption }}</div>{%- endif %}
    </div>
    {%- endif %}
    {%- endfor %}

    <div class="sparkle" style="top:70px; left:520px;"></div>
    <div class="sparkle small" style="top:340px; left:900px;"></div>
    <div class="sparkle" style="top:90px; left:1420px;"></div>
    <div class="sparkle small" style="top:480px; left:1720px;"></div>
    <div class="sparkle" style="top:200px; left:2050px;"></div>
    <div class="sparkle small" style="top:60px; left:280px;"></div>

    <div class="desktop-icon" style="left:64px; top:60px;">
      <div class="icon-link" data-window="#gallery-window" role="button" tabindex="0">
        <span class="icon-glyph"><img src="/images/icons/art_pixel_icon.png" alt=""></span>
        <span class="icon-label">art</span>
      </div>
    </div>

    <div class="desktop-icon" style="left:64px; top:170px;">
      <div class="icon-link" data-window="#writing-window" role="button" tabindex="0">
        <span class="icon-glyph"><img src="/images/icons/blog_icon.png" alt=""></span>
        <span class="icon-label">blog</span>
      </div>
    </div>

    <div class="desktop-icon" style="left:64px; top:280px;">
      <div class="icon-link" data-window="#experience-window" role="button" tabindex="0">
        <span class="icon-glyph"><img src="/images/icons/work_pixel_icon.png" alt=""></span>
        <span class="icon-label">work</span>
      </div>
    </div>

    <div class="desktop-icon" style="left:64px; top:390px;">
      <a class="icon-link" href="https://github.com/p3arldiv3r" target="_blank" rel="noopener">
        <span class="icon-glyph"><img src="/images/icons/github_pixel_icon.png" alt=""></span>
        <span class="icon-label">github</span>
      </a>
    </div>

    <div class="desktop-icon" style="left:64px; top:500px;">
      <a class="icon-link" href="https://www.linkedin.com/in/lbtrent/" target="_blank" rel="noopener">
        <span class="icon-glyph"><img src="/images/icons/linkedin_pixel_icon.png" alt="" style="transform:scale(1.15);"></span>
        <span class="icon-label">linkedin</span>
      </a>
    </div>

    <!-- second icon column -- placeholders until real pixel art is dropped in;
         reuses the same two top positions as the first column so this never
         adds height to the page, only width -->
    <div class="desktop-icon" style="left:174px; top:60px;">
      <div class="icon-link" data-window="#note-window" role="button" tabindex="0">
        <span class="icon-glyph">
          <svg viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="10" width="34" height="24" rx="3" fill="#fdf6e3" stroke="#0c3a4d" stroke-width="2"/>
            <path d="M6 12 L22 26 L38 12" fill="none" stroke="#3fa7dd" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="icon-label">note</span>
      </div>
    </div>

    <div class="desktop-icon" style="left:174px; top:170px;">
      <div class="icon-link" data-window="#doodle-window" role="button" tabindex="0">
        <span class="icon-glyph">
          <svg viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="6" width="28" height="34" rx="2" fill="#ffffff" stroke="#0c3a4d" stroke-width="2"/>
            <path d="M13 16 Q18 11 22 16 T31 16" fill="none" stroke="#e0679c" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M13 25 Q18 20 22 25 T31 25" fill="none" stroke="#7fbf3d" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="icon-label">doodle</span>
      </div>
    </div>

    <div class="desktop-window popup" id="gallery-window" style="left:930px; top:50px; width:380px;">
      <div class="win-bar">
        <span>gallery.pic</span>
        <div class="dots"><i></i><i></i><button type="button" class="win-close" aria-label="close"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg></button></div>
      </div>
      <div class="win-body">
        {%- if gallery.items.length %}
        <img class="gallery-preview" alt="">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:8px;">
          <button type="button" class="glass-btn icon-btn gallery-prev" aria-label="previous">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"></polyline></svg>
          </button>
          <div style="text-align:center;">
            <div class="gallery-filename" style="font-size:12px; font-weight:700; color:var(--glass-deep);"></div>
            <div class="gallery-caption" style="font-size:11.5px; color:var(--ink-soft);"></div>
          </div>
          <button type="button" class="glass-btn icon-btn gallery-next" aria-label="next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
          </button>
        </div>
        <div class="gallery-thumbs" style="display:flex; gap:6px; overflow-x:auto; margin-top:10px; padding-bottom:2px;">
          {%- for item in gallery.items %}
          <img class="gallery-thumb" src="{{ item.image }}" alt="{{ item.alt or item.title }}" data-image="{{ item.image }}" data-title="{{ item.title }}" data-caption="{{ item.caption or '' }}" data-alt="{{ item.alt or item.title }}">
          {%- endfor %}
        </div>
        {%- else %}
        <p style="text-align:center; color:var(--ink-soft); font-size:13px; margin:20px 0;">nothing approved yet — check back soon.</p>
        {%- endif %}
        <div style="text-align:center; margin-top:10px;">
          <a class="popup-link" href="/gallery/">see the full gallery →</a>
        </div>
      </div>
    </div>

    <div class="desktop-window popup" id="experience-window" style="left:970px; top:80px; width:380px;">
      <div class="win-bar">
        <span>experience.log</span>
        <div class="dots"><i></i><i></i><button type="button" class="win-close" aria-label="close"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg></button></div>
      </div>
      <div class="win-body" style="max-height:340px; overflow-y:auto;">
        <div class="exp-row"><b>Associate Software Engineer Intern</b><br><span class="exp-meta">Sonatype — May 2026–Aug 2026</span></div>
        <div class="exp-row"><b>Full-Stack Software Development Intern</b><br><span class="exp-meta">Infor — May 2025–Aug 2025</span></div>
        <div class="exp-row"><b>Founder &amp; Lead Developer</b><br><span class="exp-meta">Fiat Scientia — Feb 2025–May 2026</span></div>
        <div class="exp-row"><b>Document Accessibility Services Student Assistant</b><br><span class="exp-meta">Center for Inclusive Design &amp; Innovation — Aug 2024–Present</span></div>
        <div class="exp-row"><b>IT Intern &amp; Legal Assistant</b><br><span class="exp-meta">770 Good Law — Jan 2024–Aug 2024</span></div>
        <div style="text-align:center; margin-top:12px;">
          <a class="popup-link" href="/experience/">view full experience &amp; projects →</a>
        </div>
      </div>
    </div>

    <div class="desktop-window popup" id="writing-window" style="left:970px; top:230px; width:380px;">
      <div class="win-bar">
        <span>writing.log</span>
        <div class="dots"><i></i><i></i><button type="button" class="win-close" aria-label="close"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg></button></div>
      </div>
      <div class="win-body" style="max-height:280px; overflow-y:auto;">
        {%- if collections.posts.length %}
        {%- for post in collections.posts | reverse | head(3) %}
        <div class="exp-row">
          <b>{{ post.data.title }}</b><br>
          <span class="exp-meta">{{ post.data.date | date("%B %d, %Y") }}</span>
          <p style="margin:6px 0 0; font-size:12.5px; color:var(--ink-soft); line-height:1.5;">{{ post.data.excerpt }}</p>
        </div>
        {%- endfor %}
        {%- else %}
        <p style="text-align:center; color:var(--ink-soft); font-size:13px; margin:20px 0;">nothing posted yet — check back soon.</p>
        {%- endif %}
        <div style="text-align:center; margin-top:12px;">
          <a class="popup-link" href="/writing/">read all writing →</a>
        </div>
      </div>
    </div>

    <div class="desktop-window" style="left:510px; top:210px; width:400px;">
      <div class="win-bar"><span>welcome.txt</span><div class="dots"><i></i><i></i></div></div>
      <div class="win-body">
        <h1 style="font-family:'Baloo 2', sans-serif; font-size:32px; font-weight:700; margin:0 0 14px; background:linear-gradient(180deg, #ffffff 10%, #bfe9ff 35%, var(--glass-blue) 65%, var(--glass-deep) 100%); -webkit-background-clip:text; background-clip:text; color:transparent;">hi, i'm lily!</h1>
        <p style="margin:0 0 20px; color:var(--ink-soft); font-size:14px; line-height:1.6;">computer science student at georgia tech, developer, digital artist, and then some!</p>
        <div style="display:flex; flex-wrap:wrap; gap:10px;">
          <a class="glass-btn" href="https://www.linkedin.com/in/lbtrent/" target="_blank" rel="noopener">linkedin</a>
          <a class="glass-btn" href="https://github.com/p3arldiv3r" target="_blank" rel="noopener">github</a>
          <a class="glass-btn" href="/gallery/">see my art</a>
        </div>
      </div>
    </div>

    <div class="desktop-window popup" id="note-window" style="left:250px; top:440px; width:330px;">
      <div class="win-bar">
        <span>new_message.txt</span>
        <div class="dots"><i></i><i></i><button type="button" class="win-close" aria-label="close"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg></button></div>
      </div>
      <div class="win-body">
        <form class="note-form" name="note-to-lily" method="POST">
          <p style="position:absolute; left:-9999px;"><label>don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <p style="margin:0 0 14px; font-size:13px; color:var(--ink-soft);">send me a note!</p>
          <input class="field" type="text" name="name" placeholder="your name (optional)">
          <textarea class="field" name="message" rows="3" placeholder="send me a message!" required></textarea>
          <div style="display:flex; align-items:center; gap:12px; margin-top:14px;">
            <button type="submit" class="glass-btn">send</button>
            <span class="status-msg note-status">sent!</span>
          </div>
        </form>
      </div>
    </div>

    <div class="desktop-window popup" id="doodle-window" style="left:680px; top:440px; width:380px;">
      <div class="win-bar">
        <span>doodle.pad</span>
        <div class="dots"><i></i><i></i><button type="button" class="win-close" aria-label="close"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg></button></div>
      </div>
      <div class="win-body">
        <p style="margin:0 0 14px; font-size:13px; color:var(--ink-soft);">draw me something!.</p>
        <canvas class="doodle-canvas" width="336" height="150"></canvas>
        <div style="display:flex; align-items:center; gap:12px; margin-top:14px;">
          <button type="button" class="glass-btn doodle-clear">clear</button>
          <button type="button" class="glass-btn doodle-send">send</button>
          <span class="status-msg doodle-status">sent! thanks for the doodle!</span>
        </div>
      </div>
    </div>

  </div>
  <div class="hint">click and drag to look around! drag a window's title bar to move it</div>
</div>

<script src="/js/desktop.js" defer></script>
