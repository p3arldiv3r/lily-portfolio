<!DOCTYPE html>
<html lang="en">
<head>
<script>
  // Netlify Identity recovery/invite/confirmation links point at the site
  // root, not /admin/ -- bounce them to the CMS admin page (which loads the
  // identity widget) so the token in the hash actually gets picked up and
  // turned into a "set your password" form instead of silently doing nothing.
  if (/(access_token|confirmation_token|recovery_token|invite_token)=/.test(window.location.hash)) {
    window.location.replace("/admin/" + window.location.hash);
  }
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "Lillian Trent" }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700&family=Quicksand:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
  {%- if page.url == "/" %}
  <a class="logo" href="/">welcome!</a>
  {%- else %}
  <a class="logo" href="/">lily's portfolio</a>
  <div class="nav-links">
    <a href="/gallery/">art</a>
    <a href="/writing/">writing</a>
    <a href="/experience/">work</a>
    <a href="https://www.linkedin.com/in/lbtrent/" target="_blank" rel="noopener">linkedin</a>
    <a href="https://github.com/p3arldiv3r" target="_blank" rel="noopener">github</a>
  </div>
  {%- endif %}
</nav>

{{ content | safe }}

<footer>lillian b. trent — made with care</footer>

</body>
</html>
